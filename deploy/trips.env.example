# Production settings for trips.aarondaws.com.au.
# Lives at /etc/trips/trips.env (root:trips, mode 0640).
# After changing anything here: sudo systemctl restart trips

DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=trips.aarondaws.com.au
DJANGO_CSRF_TRUSTED_ORIGINS=https://trips.aarondaws.com.au
DJANGO_DB_PATH=/var/lib/trips/db.sqlite3
DJANGO_STATIC_ROOT=/var/www/trips.aarondaws.com.au/static
DJANGO_ADMIN_PATH=backstage/

DJANGO_MEDIA_ROOT=/var/lib/trips/media

# Enforce the Content-Security-Policy (1), rather than only reporting what it would block (0).
# Enforced since 15 Nov 2026, after the report-only log stayed quiet; set 0 to go back while debugging.
DJANGO_CSP_ENFORCE=1

# Cloudflare Access (Zero Trust) for /manage/ and the admin. Leave empty until
# Access is set up; then fill in both and restart (see README).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Live flight lookups for auto-fill: your RapidAPI key, subscribed to AeroDataBox's free
# Basic plan (https://rapidapi.com/aedbx-aedbx/api/aerodatabox). Leave empty to switch off.
AERODATABOX_RAPIDAPI_KEY=

# Sydney's train, metro, light rail and ferry timetables: a free Transport for NSW Open Data
# key (https://opendata.transport.nsw.gov.au). Leave empty to leave Sydney out.
TFNSW_API_KEY=

# Melbourne's live train and tram times: a free Transport Victoria open data key
# (https://opendata.transport.vic.gov.au). Leave empty for timetabled times only.
TRANSPORT_VIC_API_KEY=

# Forwarded booking confirmations. INBOUND_EMAIL_TOKEN is generated on the server;
# the signing key comes from Mailgun (Sending > Webhooks > HTTP webhook signing key);
# INBOUND_ALLOWED_SENDERS is a comma-separated list of the addresses you forward from.
INBOUND_EMAIL_TOKEN=
MAILGUN_WEBHOOK_SIGNING_KEY=
INBOUND_ALLOWED_SENDERS=

# Real flight routes from adsb.lol's free open archive (1 = on, 0 = great-circle arcs).
ADSBLOL_TRACKS=1

# Real flight routes: your Flightradar24 API token (Explorer plan, production key). Leave empty for great-circle arcs.
FLIGHTRADAR24_API_TOKEN=
