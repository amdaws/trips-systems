#!/usr/bin/python3 -I
"""Keep the web ports (80 and 443) open to Cloudflare only.

Fetches Cloudflare's published address ranges, checks they look right, and replaces the nftables
table "cloudflare_only" in one atomic step. SSH and every other port are left alone.

Installed as /usr/local/sbin/cloudflare-only-refresh and run weekly by cloudflare-only-refresh.timer.
The last good rules are kept in /etc/cloudflare-only.nft, which cloudflare-only.service loads at boot.
If anything goes wrong (no network, an odd-looking list), the current rules stay as they are.
"""

import ipaddress
import json
import os
import subprocess
import sys
import tempfile
import urllib.request

API = "https://api.cloudflare.com/client/v4/ips"
RULES = "/etc/cloudflare-only.nft"
CADDYFILE = "/etc/caddy/Caddyfile"

TEMPLATE = """#!/usr/sbin/nft -f
# Web ports 80 and 443 (TCP, and UDP for HTTP/3) accept only Cloudflare's addresses.
# Written by /usr/local/sbin/cloudflare-only-refresh: don't edit by hand. SSH and other ports are untouched.
# To switch it off: sudo systemctl disable --now cloudflare-only-refresh.timer cloudflare-only.service
table inet cloudflare_only
delete table inet cloudflare_only
table inet cloudflare_only {{
	set cloudflare_v4 {{
		type ipv4_addr
		flags interval
		elements = {{ {v4} }}
	}}
	set cloudflare_v6 {{
		type ipv6_addr
		flags interval
		elements = {{ {v6} }}
	}}
	chain input {{
		type filter hook input priority filter - 10; policy accept;
		iif "lo" accept
		meta l4proto {{ tcp, udp }} th dport {{ 80, 443 }} ip saddr @cloudflare_v4 accept
		meta l4proto {{ tcp, udp }} th dport {{ 80, 443 }} ip6 saddr @cloudflare_v6 accept
		meta l4proto {{ tcp, udp }} th dport {{ 80, 443 }} counter drop
	}}
}}
"""


def fetch():
    """Cloudflare's IPv4 and IPv6 ranges, after checks that catch a broken or tampered answer."""
    request = urllib.request.Request(API, headers={"User-Agent": "cloudflare-only-refresh"})
    with urllib.request.urlopen(request, timeout=30) as response:
        data = json.load(response)
    if not data.get("success"):
        raise ValueError("Cloudflare's API reported an error")
    v4 = sorted({ipaddress.IPv4Network(cidr) for cidr in data["result"]["ipv4_cidrs"]})
    v6 = sorted({ipaddress.IPv6Network(cidr) for cidr in data["result"]["ipv6_cidrs"]})
    # A much shorter or oddly broad list is more likely a fault than a real change.
    if len(v4) < 10 or len(v6) < 5:
        raise ValueError(f"only {len(v4)} IPv4 and {len(v6)} IPv6 ranges")
    if any(net.prefixlen < 8 for net in v4) or any(net.prefixlen < 20 for net in v6):
        raise ValueError("a range is implausibly broad")
    if not all(net.is_global for net in v4 + v6):
        raise ValueError("a range isn't public address space")
    return v4, v6


def warn_if_caddy_differs(ranges):
    """Caddy keeps its own copy of the list (trusted proxies, and the /manage check)."""
    try:
        caddyfile = open(CADDYFILE).read()
    except OSError:
        return
    missing = [str(net) for net in ranges if str(net) not in caddyfile]
    if missing:
        print(f"Warning: {CADDYFILE} lacks Cloudflare ranges {', '.join(missing)}; add them there too.", file=sys.stderr)


def main():
    try:
        v4, v6 = fetch()
    except Exception as exc:  # any failure: keep what's loaded
        print(f"Couldn't get Cloudflare's address ranges ({exc}); keeping the current rules.", file=sys.stderr)
        return 1
    text = TEMPLATE.format(v4=", ".join(map(str, v4)), v6=", ".join(map(str, v6)))
    try:
        old = open(RULES).read()
    except FileNotFoundError:
        old = None
    loaded = subprocess.run(["nft", "list", "table", "inet", "cloudflare_only"], capture_output=True).returncode == 0
    warn_if_caddy_differs(v4 + v6)
    if text == old and loaded:
        print(f"No change: {len(v4)} IPv4 and {len(v6)} IPv6 Cloudflare ranges.")
        return 0

    with tempfile.NamedTemporaryFile("w", dir="/etc", prefix=".cloudflare-only.", suffix=".nft", delete=False) as new:
        new.write(text)
    check = subprocess.run(["nft", "-c", "-f", new.name], capture_output=True, text=True)
    if check.returncode:
        os.unlink(new.name)
        print(f"The new rules failed nft's check; keeping the current ones.\n{check.stderr}", file=sys.stderr)
        return 1
    os.chmod(new.name, 0o644)
    os.replace(new.name, RULES)
    applied = subprocess.run(["nft", "-f", RULES], capture_output=True, text=True)
    if applied.returncode:
        print(f"Couldn't load the rules:\n{applied.stderr}", file=sys.stderr)
        return 1
    change = "first load" if old is None else ("ranges changed" if old != text else "reloaded")
    print(f"Loaded {len(v4)} IPv4 and {len(v6)} IPv6 Cloudflare ranges ({change}).")
    return 0


if __name__ == "__main__":
    sys.exit(main())
